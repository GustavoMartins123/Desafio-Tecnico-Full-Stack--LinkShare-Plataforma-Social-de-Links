# ========================================
# LinkShare - Environment Variables
# ========================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control!

# ----------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=linkshare
POSTGRES_PORT=5432

# ----------------------------------------
# API Configuration
# ----------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# ----------------------------------------
# JWT Authentication
# ----------------------------------------
# IMPORTANT: Change this secret key in production!
# Must be at least 32 characters long
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLongForProduction!
JWT_ISSUER=LinkShareAPI
JWT_AUDIENCE=LinkShareClient
JWT_EXPIRATION_MINUTES=60

# ----------------------------------------
# Notes
# ----------------------------------------
# - Generate a secure random key for JWT_SECRET_KEY in production
# - Use strong passwords for POSTGRES_PASSWORD
# - Never commit the .env file to Git
# - Restart containers after changing environment variables
